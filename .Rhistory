R2_ajustado = round(c(summary(modelo_1)$adj.r.squared,
summary(modelo_covid)$adj.r.squared), 3),
Brasil = round(c(coef(modelo_1)["ln_brasil"], coef(modelo_covid)["ln_brasil"]), 3),
